# DESi Workbench - example environment (offline defaults, no secrets).
#
# Copy to .env for local overrides. .env is gitignored. Never commit keys.

# --- Backend ---
# Offline by default. Live LLM calls require BOTH gates flipped AND a key
# in the env var named below. The MVP pipeline is offline-only and makes
# no network calls regardless.
DESI_WORKBENCH_OFFLINE_MODE=true
DESI_WORKBENCH_ALLOW_LIVE_LLM_CALLS=false

# Only the NAME of the env var that would hold a key. The key value is
# never read into config, logged, sent to the frontend, or written to a
# report. Leave the actual key OUT of any committed file.
DESI_WORKBENCH_API_KEY_ENV=DESI_WORKBENCH_API_KEY
# DESI_WORKBENCH_API_KEY=         # <- set only in your local .env, never commit

# Opt-in live SPL projection endpoint (OpenAI-compatible). Not secrets — the
# key lives in the env var named above. Only used when BOTH gates are open.
# DESI_WORKBENCH_LLM_BASE_URL=https://openrouter.ai/api/v1
# DESI_WORKBENCH_LLM_MODEL=deepseek/deepseek-chat

# Where reviews are stored (gitignored).
# DESI_WORKBENCH_DATA_DIR=./data/reviews

# --- Frontend ---
# Base URL the browser uses to reach the backend.
NEXT_PUBLIC_API_BASE=http://localhost:8000
